---
import type { ProjectClosing as ProjectClosingData } from '../../data/projects/types';

interface Props {
  closing: ProjectClosingData;
  lang: 'es' | 'en';
}

const { closing, lang } = Astro.props;
const lines = closing.lines[lang];
---

<div class="mb-12 lg:mb-16 text-center max-w-4xl mx-auto px-2">
  {lines.map((line, i) => (
    <p
      class:list={[
        "[font-family:'Bricolage_Grotesque',Helvetica] text-[#13243c] leading-tight",
        i === 0
          ? 'font-medium text-xl md:text-2xl lg:text-3xl mb-3'
          : 'font-medium text-[clamp(1.75rem,1.2rem+2vw,3.75rem)]',
      ]}
    >
      {line}
    </p>
  ))}
</div>
